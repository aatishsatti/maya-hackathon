<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications (this is what lets the phone have a push token, VoIP included). Xcode puts "production" here by itself when it archives for TestFlight or the App Store. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
